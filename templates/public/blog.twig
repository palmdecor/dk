{% include 'partials/header.twig' %}
<section class="page-header">
    <div class="container">
        <h1>Blog</h1>
    </div>
</section>
<section class="blog">
    <div class="container">
        <div class="grid">
            {% for post in blog %}
                <article class="card">
                    <img src="{{ post.image }}" alt="{{ post.title }}">
                    <h3>{{ post.title }}</h3>
                    <p>{{ post.excerpt }}</p>
                    <a href="/blog_detail.php?slug={{ post.slug }}" class="button-outline">Oku</a>
                </article>
            {% endfor %}
        </div>
    </div>
</section>
{% include 'partials/footer.twig' %}
