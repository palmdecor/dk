{% extends 'admin/layout.twig' %}

{% block title %}Mesajlar{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card__header">
        <h2>İletişim Mesajları</h2>
    </div>
    <table class="admin-table">
        <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Konu</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr class="{% if not item.is_read %}is-unread{% endif %}">
                <td>{{ item.name }}</td>
                <td><a href="mailto:{{ item.email }}">{{ item.email }}</a></td>
                <td>{{ item.subject }}</td>
                <td>{{ item.is_read ? 'Okundu' : 'Okunmadı' }}</td>
                <td class="admin-table__actions">
                    <a href="/admin/message_edit.php?id={{ item.id }}">Görüntüle</a>
                    <form method="post" action="/admin/message_delete.php?id={{ item.id }}" onsubmit="return confirm('Silinsin mi?');">
                        <input type="hidden" name="_token" value="{{ csrf.generateToken('messages_form') }}">
                        <input type="hidden" name="_token_id" value="messages_form">
                        <button type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Mesaj bulunamadı.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
