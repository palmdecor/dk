{% extends 'admin/layout.twig' %}

{% block title %}Slider{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card__header">
        <h2>Slider Öğeleri</h2>
        <a class="admin-button" href="/admin/slider_add.php">Yeni Slider</a>
    </div>
    <table class="admin-table">
        <thead>
        <tr>
            <th>Başlık</th>
            <th>Sıra</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.title }}</td>
                <td>{{ item.sort_order }}</td>
                <td>{{ item.status }}</td>
                <td class="admin-table__actions">
                    <a href="/admin/slider_edit.php?id={{ item.id }}">Düzenle</a>
                    <form method="post" action="/admin/slider_delete.php?id={{ item.id }}" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                        <input type="hidden" name="_token" value="{{ csrf.generateToken('sliders_form') }}">
                        <input type="hidden" name="_token_id" value="sliders_form">
                        <button type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Slider verisi yok.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
