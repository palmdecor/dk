{% extends 'admin/layout.twig' %}

{% block title %}Hizmetler{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card__header">
        <h2>Hizmetler</h2>
        <a class="admin-button" href="/admin/service_add.php">Yeni Hizmet</a>
    </div>
    <table class="admin-table">
        <thead>
        <tr>
            <th>Başlık</th>
            <th>Durum</th>
            <th>Oluşturulma</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.title }}</td>
                <td>{{ item.status }}</td>
                <td>{{ item.created_at|date('d.m.Y H:i') }}</td>
                <td class="admin-table__actions">
                    <a href="/admin/service_edit.php?id={{ item.id }}">Düzenle</a>
                    <form method="post" action="/admin/service_delete.php?id={{ item.id }}" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                        <input type="hidden" name="_token" value="{{ csrf.generateToken('services_form') }}">
                        <input type="hidden" name="_token_id" value="services_form">
                        <button type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Henüz kayıt eklenmemiş.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
