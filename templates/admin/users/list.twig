{% extends 'admin/layout.twig' %}

{% block title %}Kullanıcılar{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card__header">
        <h2>Kullanıcılar</h2>
        <a class="admin-button" href="/admin/user_add.php">Yeni Kullanıcı</a>
    </div>
    <table class="admin-table">
        <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Rol</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.name }}</td>
                <td>{{ item.email }}</td>
                <td>{{ item.role|capitalize }}</td>
                <td>{{ item.status }}</td>
                <td class="admin-table__actions">
                    <a href="/admin/user_edit.php?id={{ item.id }}">Düzenle</a>
                    <form method="post" action="/admin/user_delete.php?id={{ item.id }}" onsubmit="return confirm('Silinsin mi?');">
                        <input type="hidden" name="_token" value="{{ csrf.generateToken('users_form') }}">
                        <input type="hidden" name="_token_id" value="users_form">
                        <button type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Kullanıcı bulunamadı.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
