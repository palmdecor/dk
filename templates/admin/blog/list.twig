{% extends 'admin/layout.twig' %}

{% block title %}Blog Yazıları{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card__header">
        <h2>Blog Yazıları</h2>
        <a class="admin-button" href="/admin/blog_add.php">Yeni Yazı</a>
    </div>
    <table class="admin-table">
        <thead>
        <tr>
            <th>Başlık</th>
            <th>Durum</th>
            <th>Yayın Tarihi</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.title }}</td>
                <td>{{ item.status }}</td>
                <td>{{ item.published_at ? item.published_at|date('d.m.Y H:i') : '-' }}</td>
                <td class="admin-table__actions">
                    <a href="/admin/blog_edit.php?id={{ item.id }}">Düzenle</a>
                    <form method="post" action="/admin/blog_delete.php?id={{ item.id }}" onsubmit="return confirm('Silinsin mi?');">
                        <input type="hidden" name="_token" value="{{ csrf.generateToken('blogs_form') }}">
                        <input type="hidden" name="_token_id" value="blogs_form">
                        <button type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Blog yazısı bulunamadı.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
