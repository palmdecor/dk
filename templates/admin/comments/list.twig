{% extends 'admin/layout.twig' %}

{% block title %}Yorumlar{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card__header">
        <h2>Yorumlar</h2>
        <a class="admin-button" href="/admin/comment_add.php">Yorum Ekle</a>
    </div>
    <table class="admin-table">
        <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Durum</th>
            <th>İçerik</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.author_name }}</td>
                <td>{{ item.status }}</td>
                <td>{{ item.content|length > 80 ? item.content|slice(0, 80) ~ '...' : item.content }}</td>
                <td class="admin-table__actions">
                    <a href="/admin/comment_edit.php?id={{ item.id }}">Düzenle</a>
                    <form method="post" action="/admin/comment_delete.php?id={{ item.id }}" onsubmit="return confirm('Silinsin mi?');">
                        <input type="hidden" name="_token" value="{{ csrf.generateToken('comments_form') }}">
                        <input type="hidden" name="_token_id" value="comments_form">
                        <button type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Yorum bulunamadı.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
